{
  "name": "@simonefiore/react-three-arjs",
  "version": "0.1.0",
  "description": "Marker-based and location-based augmented reality for React Three Fiber. A TypeScript rewrite of AR.js.",
  "keywords": [
    "augmented reality",
    "ar",
    "ar.js",
    "artoolkit",
    "react",
    "react-three-fiber",
    "three",
    "webar",
    "marker",
    "location-based",
    "gps"
  ],
  "license": "MIT",
  "author": "Simone Fiore (https://www.npmjs.com/~simonefiore)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fioresimone/react-three-arjs.git",
    "directory": "packages/react-three-arjs"
  },
  "homepage": "https://github.com/fioresimone/react-three-arjs/tree/main/packages/react-three-arjs#readme",
  "bugs": {
    "url": "https://github.com/fioresimone/react-three-arjs/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/wasm.generated-*.js.map",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./assets/*": "./dist/assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate-assets.mjs",
    "prebuild": "node scripts/generate-assets.mjs",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "pretest": "node scripts/generate-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "node scripts/generate-assets.mjs",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.170.0"
  },
  "dependencies": {
    "@ar-js-org/artoolkit5-ts": "0.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@react-three/fiber": "^9.8.2",
    "@testing-library/react": "^16.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4",
    "pngjs": "^7.0.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
